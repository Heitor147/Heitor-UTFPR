
@url = http://localhost:3000

# ========================================
# Roteiro 10 - Validacao de persistencia
# ========================================

POST {{url}}/lab/tarefas
Content-Type: application/json

{
    "descricao": "Primeira tarefa persistida no PostgreSQL"
}

###

GET {{url}}/lab/tarefas

###

GET {{url}}/tarefas

###

# Buscando tarefas por Query String (Filtro)
GET {{url}}/tarefas?busca=estudar

###

POST {{url}}/tarefas
Content-Type: application/json

{
    "id": 4,
    "descricao": "Tarefa 4",
    "concluido": false
}

###

GET {{url}}/tarefas/resumo

###

GET {{url}}/tarefas/1

###

PATCH {{url}}/tarefas/1
Content-Type: application/json

{
    "descricao": "Fazer compras no mercado",
    "concluido": true
}

###

DELETE {{url}}/tarefas/1

###

# Forçando erro 404 no NotFoundHandler
GET {{url}}/batata-frita